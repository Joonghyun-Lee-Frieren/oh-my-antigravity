{
  "name": "oh-my-antigravity",
  "version": "0.10.0",
  "description": "Native Antigravity workflows, current Gemini profiles, and bounded agent verification.",
  "keywords": [
    "antigravity",
    "antigravity-cli",
    "gemini",
    "gemini-cli",
    "extension",
    "agents",
    "skills",
    "context-engineering"
  ],
  "homepage": "https://github.com/Joonghyun-Lee-Frieren/oh-my-antigravity",
  "repository": {
    "type": "git",
    "url": "https://github.com/Joonghyun-Lee-Frieren/oh-my-antigravity.git"
  },
  "license": "MIT",
  "author": "Joonghyun-Lee-Frieren",
  "type": "module",
  "scripts": {
    "test:version": "node scripts/check-version.js",
    "test:skills": "node scripts/check-skill-metadata.js",
    "sync:version": "node scripts/sync-version.js",
    "test": "node --test tests/*.test.mjs",
    "build:hooks": "node scripts/build-native-hooks.mjs",
    "check:hooks": "node scripts/build-native-hooks.mjs --check",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run test:version && npm run test:skills && npm run check:hooks && npm run test:package"
  },
  "files": [
    "GEMINI.md",
    "gemini-extension.json",
    "agents/",
    "commands/",
    "hooks/",
    "skills/",
    "context/",
    "README.md",
    "docs/",
    "LICENSE",
    "plugin.json",
    "hooks.json",
    "config/",
    "rules/",
    "scripts/",
    "tests/",
    "resources/"
  ],
  "engines": {
    "node": ">=22"
  }
}
